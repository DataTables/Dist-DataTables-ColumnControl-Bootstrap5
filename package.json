{
    "name": "datatables.net-columncontrol-bs5",
    "description": "ColumnControl for DataTables with styling for [Bootstrap5](https://getbootstrap.com/)",
    "main": "./js/columnControl.bootstrap5.js",
    "module": "./js/columnControl.bootstrap5.mjs",
    "style": "./css/columnControl.bootstrap5.css",
    "types": "./types/columnControl.bootstrap5.d.ts",
    "version": "2.1.0",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "ColumnControl",
        "search",
        "filter",
        "buttons",
        "column visibility",
        "Bootstrap",
        "Bootstrap5",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-columncontrol": "2.1.0",
        "datatables.net-bs5": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/ColumnControl.git"
    },
    "exports": {
        ".": {
            "types": "./types/columnControl.bootstrap5.d.ts",
            "import": "./js/columnControl.bootstrap5.mjs",
            "default": "./js/columnControl.bootstrap5.mjs",
            "require": "./js/columnControl.bootstrap5.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/columnControl.bootstrap5.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}